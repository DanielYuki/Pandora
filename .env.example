# Environment
NODE_ENV=development
PORT=3001 # or 8080

# WhatsApp Configuration  
CLOUD_API_ACCESS_TOKEN=your_whatsapp_access_token_here
CLOUD_API_VERSION=v19.0
WA_ACCOUNT_ID=your_acc_id_here
WA_PHONE_NUMBER_ID=your_phone_number_id_here
WA_WEBHOOK_TOKEN=your_webhook_verification_token_here

# Servers
AGENT_SERVER_ADDRESS=localhost:50051

# Logging
LOG_LEVEL=debug
